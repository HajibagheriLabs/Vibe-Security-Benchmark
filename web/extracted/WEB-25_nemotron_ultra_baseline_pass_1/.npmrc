# Use exact versions to ensure reproducible installs
save-exact=true

# Enable strict peer dependency resolution (recommended for Next.js)
legacy-peer-deps=false
strict-peer-dependencies=true

# Optimize for CI environments
prefer-offline=true
audit-level=moderate
fund=false

# Use npm's workspaces feature if monorepo
# workspaces=true

# Registry configuration (use official registry)
registry=https://registry.npmjs.org/

# Engine strictness
engine-strict=true