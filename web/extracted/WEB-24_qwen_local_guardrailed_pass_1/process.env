import crypto from 'crypto';
import { v4 as uuidv4 } from 'uuid';
import { config } from './config';

export interface SessionToken {
  id: string;
  secret: string;
  expiresAt: Date;
  createdAt: Date;
}

export class SessionTokenGenerator {
  /**
   * Generates a cryptographically secure session token.
   * Combines a UUID (for unique ID) and a random secret (for secrecy).
   *
   * @returns SessionToken object
   */
  generate(): SessionToken {
    const id = uuidv4();
    const secret = crypto.randomBytes(32).toString('hex');
    const createdAt = new Date();
    const expiresAt = new Date(createdAt.getTime() + config.SESSION_EXPIRY_MS);

    return { id, secret, expiresAt, createdAt };
  }

  /**
   * Verifies a provided secret against a known token ID.
   * Uses timing-safe comparison to prevent timing attacks.
   *
   * @param id - The session token ID
   * @param secret - The provided secret
   * @param knownSecret - The stored secret for comparison
   * @returns true if valid, false otherwise
   */
  verify(id: string, secret: string, knownSecret: string): boolean {
    const providedHash = crypto.createHash('sha256').update(secret).digest('hex');
    const knownHash = crypto.createHash('sha256').update(knownSecret).digest('hex');
    return crypto.timingSafeEqual(Buffer.from(providedHash), Buffer.from(knownHash));
  }

  /**
   * Encodes the token into a cookie-safe string.
   * Format: id:secret
   *
   * @param token - SessionToken object
   * @returns Encoded string
   */
  encode(token: SessionToken): string {
    return `${token.id}:${token.secret}`;
  }

  /**
   * Decodes a cookie-safe string back into a SessionToken.
   *
   * @param encoded - Encoded string
   * @returns SessionToken object
   */
  decode(encoded: string): SessionToken {
    const [id, secret] = encoded.split(':');
    if (!id || !secret) {
      throw new Error('Invalid token format');
    }
    return {
      id,
      secret,
      expiresAt: new Date(Date.now() + config.SESSION_EXPIRY_MS),
      createdAt: new Date(),
    };
  }
}