# Enforce exact versioning and strict install behavior
save-exact=true
save-prefix=''

# Disable lifecycle scripts by default for security (rule 4.4)
ignore-scripts=true

# Allow specific safe scripts if needed (e.g., postinstall for build artifacts)
# update-usage=true # Optional: keep dependencies fresh

# Registry configuration (default is npm, but explicit is better for audits)
registry=https://registry.npmjs.org/