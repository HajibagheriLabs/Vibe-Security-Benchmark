# .npmrc
# Source of truth for dependency installation behavior.
# See modules/04-supply-chain.md for full specifications.

# Rule 4: Pin exact versions. No ^, ~, *, or latest.
save-exact=true
save-dev-exact=true
save-optional-exact=true
save-peer-exact=true

# Rule 4: Ignore all lifecycle scripts by default.
# Allowlist specific scripts in package.json if needed (e.g., postinstall).
ignore-scripts=true

# Rule 4: Require integrity hashes.
# Ensures packages are not tampered with during fetch/install.
package-lock=true
audit=false

# Optional: Private registry scope binding
; @myorg:registry=https://npm.myorg.com/