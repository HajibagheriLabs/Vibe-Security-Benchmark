# Dependency installation policy
# Applies AGENT_RULES §4 — verify, pin, and isolate dependency installation.

# Never execute arbitrary package lifecycle scripts during install.
# Allowlist specific scripts in package.json only if absolutely required.
ignore-scripts=true

# Pin exact versions; no semver ranges.
save-exact=true

# Prefer lockfile reproducibility.
package-lock=true

# Never write credentials or tokens into the lockfile or registry config.
# Auth tokens belong in environment variables or CI secret stores only.
# If a private registry is required, scope it explicitly (see below).

# Example private registry scoping (uncomment and replace values if needed):
# @your-org:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${NPM_TOKEN}

# Audit on install to surface known vulnerabilities.
audit=true

# Prefer deterministic resolution.
fund=false